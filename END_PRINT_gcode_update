[gcode_macro END_PRINT]
description: Finish print and move to inspection position
variable_state: 'normal'
gcode:
    {% set z_max = printer['gcode_macro _global_var'].z_maximum_lifting_distance|int %}
    {% set e_mintemp  = printer.configfile.settings['extruder'].min_extrude_temp %}

    M117 Finish Print!!!
    
    # 1. Initial Retraction and slight lift
    G91 ; Relative positioning
    {% if printer['filament_switch_sensor filament_sensor'].enable == True and
          printer['filament_switch_sensor filament_sensor'].filament_detected == True
    %}
        {% if printer.extruder.temperature >= e_mintemp %}
            G1 E-2 F2700
            G1 E-2 Z0.2 F2400
        {% endif %}
    {% endif %}

    # 2. Move to Inspection Position (X1, Y130, Z250)
    # This uses the specific coordinates for your camera view
    G90 ; Absolute positioning
    G1 X1 Y130 Z250 F3000 

    # 3. Power down thermal components and fans
    _ALL_FAN_OFF
    TURN_OFF_HEATERS

    # 4. Cleanup and reset
    # M84 is removed here so the 10-minute timeout logic can take over.
    # This keeps the printer homed so you can perform your inspection.
    
    M220 S100
    M221 S100

    CLEAR_PAUSE
    SET_GCODE_OFFSET Z=0 MOVE=1
    {action_respond_info("Finish Print! Toolhead moved to inspection position. Motors will disable in 10 minutes.")}
